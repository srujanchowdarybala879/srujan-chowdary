        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Hunting the Reward Hack\n",
        "# Compare reward models and observe reward hacking\n",
        "\n",
        "def gold_reward(quality, flattery):\n",
        "    return quality - 0.5 * flattery**2\n",
        "\n",
        "\n",
        "def generate_training_data(size, rng):\n",
        "    # Generate training data\n",
        "    flattery = np.abs(rng.normal(size=size))\n",
        "    quality = 0.65 * flattery + rng.normal(size=size)\n",
        "\n",
        "    gold = gold_reward(quality, flattery)\n",
        "\n",
        "    # Simulate biased training labels that reward flattery\n",
        "    labels = gold + 4.0 * flattery\n",
        "    labels += rng.normal(scale=0.15, size=size)\n",
        "\n",
        "    return quality, flattery, labels\n",
        "\n",
        "\n",
        "def get_features(quality, flattery, model_size):\n",
        "    features = [quality, flattery]\n",
        "\n",
        "    if model_size in (\"medium\", \"large\"):\n",
        "        features.append(flattery**2)\n",
        "\n",
        "    if model_size == \"large\":\n",
        "        features.append(flattery**3)\n",
        "        features.append(quality * flattery)\n",
        "\n",
        "    return np.column_stack(features)\n",
        "\n",
        "\n",
        "def train_reward_model(training_size, model_size, rng):\n",
        "    quality, flattery, labels = generate_training_data(\n",
        "        training_size, rng\n",
        "    )\n",
        "\n",
        "    x = get_features(quality, flattery, model_size)\n",
        "\n",
        "    # Standardize features\n",
        "    mean = x.mean(axis=0)\n",
        "    std = x.std(axis=0)\n",
        "    std[std < 1e-8] = 1.0\n",
        "    x = (x - mean) / std\n",
        "\n",
        "    # Train using ridge regression\n",
        "    design = np.column_stack([np.ones(training_size), x])\n",
        "    penalty = np.eye(design.shape[1]) * 0.001\n",
        "    penalty[0, 0] = 0\n",
        "\n",
        "    weights = np.linalg.solve(\n",
        "        design.T @ design + penalty,\n",
        "        design.T @ labels\n",
        "    )\n",
        "\n",
        "    def predict(quality, flattery):\n",
        "        x_new = get_features(quality, flattery, model_size)\n",
        "        x_new = (x_new - mean) / std\n",
        "        x_new = np.column_stack([np.ones(len(x_new)), x_new])\n",
        "        return x_new @ weights\n",
        "\n",
        "    return predict\n",
        "\n",
        "\n",
        "def evaluate_model(predict, n_values, trials, rng):\n",
        "    results = []\n",
        "\n",
        "    for n in n_values:\n",
        "        gold_scores = []\n",
        "        flattery_scores = []\n",
        "\n",
        "        for _ in range(trials):\n",
        "            # Generate candidate answers\n",
        "            quality = rng.normal(size=n)\n",
        "            flattery = np.abs(rng.normal(size=n))\n",
        "\n",
        "            # Select answer with highest predicted reward\n",
        "            proxy = predict(quality, flattery)\n",
        "            best = np.argmax(proxy)\n",
        "\n",
        "            # Evaluate using the true reward\n",
        "            gold = gold_reward(\n",
        "                quality[best], flattery[best]\n",
        "            )\n",
        "\n",
        "            gold_scores.append(gold)\n",
        "            flattery_scores.append(flattery[best])\n",
        "\n",
        "        results.append({\n",
        "            \"n\": n,\n",
        "            \"gold\": np.mean(gold_scores),\n",
        "            \"flattery\": np.mean(flattery_scores)\n",
        "        })\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "def main():\n",
        "    rng = np.random.default_rng(7)\n",
        "\n",
        "    n_values = [1, 2, 4, 8, 16, 64, 256]\n",
        "    training_sizes = [100, 1000, 10000]\n",
        "    model_sizes = [\"small\", \"medium\", \"large\"]\n",
        "    trials = 500\n",
        "\n",
        "    all_results = {}\n",
        "\n",
        "    print(\"\\nHUNTING THE REWARD HACK\")\n",
        "    print(\"=\" * 65)\n",
        "\n",
        "    for training_size in training_sizes:\n",
        "        for model_size in model_sizes:\n",
        "\n",
        "            # Train the reward model\n",
        "            predict = train_reward_model(\n",
        "                training_size, model_size, rng\n",
        "            )\n",
        "\n",
        "            # Test best-of-n selection\n",
        "            results = evaluate_model(\n",
        "                predict, n_values, trials, rng\n",
        "            )\n",
        "\n",
        "            all_results[(training_size, model_size)] = results\n",
        "\n",
        "            # Find the maximum gold reward\n",
        "            peak = max(results, key=lambda item: item[\"gold\"])\n",
        "            last = results[-1]\n",
        "\n",
        "            print(\n",
        "                f\"Training data: {training_size:5d} | \"\n",
        "                f\"Model: {model_size:6s} | \"\n",
        "                f\"Peak n: {peak['n']:3d} | \"\n",
        "                f\"Peak gold reward: {peak['gold']:+.3f} | \"\n",
        "                f\"Gold at n=256: {last['gold']:+.3f} | \"\n",
        "                f\"Flattery at n=256: {last['flattery']:.3f}\"\n",
        "            )\n",
        "\n",
        "    # Plot the results\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
        "\n",
        "    markers = {\n",
        "        \"small\": \"o\",\n",
        "        \"medium\": \"s\",\n",
        "        \"large\": \"^\"\n",
        "    }\n",
        "\n",
        "    for (training_size, model_size), results in all_results.items():\n",
        "        n = [r[\"n\"] for r in results]\n",
        "        gold = [r[\"gold\"] for r in results]\n",
        "        flattery = [r[\"flattery\"] for r in results]\n",
        "\n",
        "        label = f\"{model_size}, data={training_size}\"\n",
        "\n",
        "        axes[0].plot(\n",
        "            n, gold, marker=markers[model_size], label=label\n",
        "        )\n",
        "\n",
        "        axes[1].plot(\n",
        "            n, flattery, marker=markers[model_size], label=label\n",
        "        )\n",
        "\n",
        "    for ax in axes:\n",
        "        ax.set_xscale(\"log\", base=2)\n",
        "        ax.set_xticks(n_values)\n",
        "        ax.set_xticklabels(n_values)\n",
        "        ax.set_xlabel(\"Number of candidates (n)\")\n",
        "        ax.grid(True, alpha=0.3)\n",
        "\n",
        "    axes[0].set_title(\"Gold Reward vs Best-of-n\")\n",
        "    axes[0].set_ylabel(\"Mean Gold Reward\")\n",
        "    axes[0].legend(fontsize=8)\n",
        "\n",
        "    axes[1].set_title(\"Flattery vs Best-of-n\")\n",
        "    axes[1].set_ylabel(\"Mean Flattery\")\n",
        "    axes[1].legend(fontsize=8)\n",
        "\n",
        "    plt.suptitle(\"Hunting the Reward Hack\")\n",
        "    plt.tight_layout()\n",
        "\n",
        "    # Save and display graphs\n",
        "    plt.savefig(\"reward_hack_results.png\", dpi=150)\n",
        "    print(\"\\nGraph saved as reward_hack_results.png\")\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ],
